APP_ENV=development
LOG_LEVEL=INFO

# Async runtime URL (uygulama bunu kullanir)
DATABASE_URL=postgresql+asyncpg://kobi:kobi@localhost:5434/kobi_db
# Sync URL (Alembic icin)
DATABASE_SYNC_URL=postgresql+psycopg://kobi:kobi@localhost:5434/kobi_db
# Test DB icin async URL
DATABASE_TEST_URL=postgresql+asyncpg://kobi:kobi@localhost:5434/kobi_test_db

# ---------- Gemini (AI agent + tools) ----------
GEMINI_API_KEY=
# Cogul key fallback: virgulle ayrilmis, 429 alinca siradakine gecer
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-latest

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change_me
# Admin'in Telegram chat ID'si — sabah brifingi + gecikme alarmlari icin
ADMIN_TELEGRAM_ID=

# ---------- Admin / Auth ----------
ADMIN_TOKEN=change_me

# JWT for admin login (run: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change_me_to_random_64_chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ---------- STT (Telegram sesli mesaj transcript) ----------
STT_ENABLED=false
STT_PROVIDER=whisper

# ---------- Kargo (mock + bildirim) ----------
# Mock kargo durumunu N dakikada bir bir adim ilerlet
CARGO_AUTO_ADVANCE=false
CARGO_AUTO_ADVANCE_INTERVAL_MIN=2
# Kargoya verildi/yolda/teslim AI ile musteriye Telegram mesaji (opt-in)
SHIPMENT_NOTIFICATIONS_ENABLED=false
# Kargo gecikmesi tespit edilince musteriye + admin'e Telegram bildirimi (opt-in)
PROACTIVE_NOTIFICATIONS_ENABLED=false

# ---------- Prediktif stok tahmin job'u ----------
STOCK_FORECAST_ENABLED=false
STOCK_FORECAST_INTERVAL_HOURS=6
STOCK_FORECAST_DAYS_AHEAD=7

# ---------- Sosyal medya gorsel/video uretimi ----------
# placeholder = picsum.photos mock (demo); openai = DALL-E 3 (gercek API)
IMAGE_PROVIDER=placeholder
# DALL-E (sosyal medya gorseli) ve Whisper (STT) icin ayni key kullanilir
OPENAI_API_KEY=

CORS_ORIGINS=http://localhost:3000
