APP_ENV=development
LOG_LEVEL=INFO

# Async runtime URL (uygulama bunu kullanir)
DATABASE_URL=postgresql+asyncpg://kobi:kobi@localhost:5434/kobi_db
# Sync URL (Alembic icin)
DATABASE_SYNC_URL=postgresql+psycopg://kobi:kobi@localhost:5434/kobi_db
# Test DB icin async URL
DATABASE_TEST_URL=postgresql+asyncpg://kobi:kobi@localhost:5434/kobi_test_db

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change_me
ADMIN_TOKEN=change_me

# JWT for admin login (run: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change_me_to_random_64_chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

STT_ENABLED=false
STT_PROVIDER=whisper
CARGO_AUTO_ADVANCE=false
CARGO_AUTO_ADVANCE_INTERVAL_MIN=2
CORS_ORIGINS=http://localhost:3000
